{
  "name": "sshclient",
  "version": "0.2.1",
  "description": "A custom SSH and SFTP client",
  "main": "src/main/main.js",
  "desktopName": "sshclient.desktop",
  "scripts": {
    "test": "node --test test/*.test.js",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 && electron . --dev",
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "build": "vite build",
    "start": "vite build && electron .",
    "dist:mac": "vite build && electron-builder --mac",
    "dist:win": "vite build && electron-builder --win",
    "dist:linux": "vite build && electron-builder --linux",
    "dist:linux:arch": "vite build && electron-builder --linux pacman",
    "postinstall": "electron-builder install-app-deps",
    "test:linux:smoke": "electron scripts/linux-smoke.cjs",
    "release:linux:checksums": "node scripts/linux-checksums.cjs"
  },
  "author": "Vapourware-Studios",
  "license": "GPL-3.0-only",
  "build": {
    "appId": "net.vapourware-studios.sshclient",
    "productName": "SSH Client",
    "directories": {
      "output": "release"
    },
    "protocols": {
      "name": "SSH Client",
      "schemes": [
        "sshclient"
      ]
    },
    "asarUnpack": [
      "**/*.node"
    ],
    "compression": "normal",
    "publish": {
      "provider": "github",
      "owner": "Vapourware-Studios",
      "repo": "sshclient"
    },
    "afterPack": "build/afterPack.js",
    "mac": {
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "sshclient needs local network access to reach SSH and SFTP servers on your network, such as routers, NAS devices and home lab machines."
      }
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm",
        "pacman"
      ],
      "executableName": "sshclient",
      "syncDesktopName": true,
      "icon": "build/icon.png",
      "category": "Network",
      "synopsis": "SSH + SFTP client",
      "description": "An SSH and SFTP client with a tabbed terminal, saved hosts and an encrypted vault.",
      "maintainer": "Vapourware-Studios <noreply@vapourware-studios.net>",
      "desktop": {
        "entry": {
          "MimeType": "x-scheme-handler/sshclient;"
        }
      },
      "artifactName": "${name}-${version}-linux-${arch}.${ext}"
    },
    "files": [
      "src/main/**/*",
      "src/preload/**/*",
      "src/renderer/assets/icon.png",
      "dist/renderer/**/*",
      "package.json"
    ],
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnss3",
        "libnspr4",
        "libxss1",
        "libxtst6",
        "libatspi2.0-0",
        "libuuid1",
        "libgbm1",
        "libasound2",
        "libsecret-1-0",
        "libsecret-tools",
        "xdg-utils",
        "udev"
      ]
    },
    "rpm": {
      "depends": [
        "gtk3",
        "nss",
        "nspr",
        "libXScrnSaver",
        "(libXtst or libXtst6)",
        "at-spi2-core",
        "(libuuid or libuuid1)",
        "libgbm.so.1()(64bit)",
        "libasound.so.2()(64bit)",
        "libsecret-1.so.0()(64bit)",
        "/usr/bin/secret-tool",
        "xdg-utils",
        "/usr/bin/udevadm"
      ]
    },
    "pacman": {
      "depends": [
        "alsa-lib",
        "at-spi2-core",
        "bash",
        "cairo",
        "dbus",
        "expat",
        "gcc-libs",
        "glib2",
        "glibc",
        "gtk3",
        "libcups",
        "libdrm",
        "libsecret",
        "libx11",
        "libxcb",
        "libxcomposite",
        "libxdamage",
        "libxext",
        "libxfixes",
        "libxkbcommon",
        "libxrandr",
        "mesa",
        "nspr",
        "nss",
        "pango",
        "systemd-libs",
        "xdg-utils",
        "systemd"
      ],
      "artifactName": "${name}-${version}-linux-${arch}.pkg.tar.zst",
      "compression": "zstd"
    }
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.4",
    "electron": "^43.1.0",
    "electron-builder": "^26.2.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.1.4",
    "wait-on": "^9.0.10"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.23.0",
    "node-pty": "^1.1.0",
    "radix-ui": "^1.6.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "serialport": "^13.0.0",
    "simple-icons": "^16.26.0",
    "snappyjs": "^0.7.0",
    "ssh2": "^1.17.0",
    "tailwind-merge": "^3.6.0",
    "tweetnacl": "^1.0.3",
    "ws": "^8.21.3"
  },
  "optionalDependencies": {
    "electron-liquid-glass": "^1.1.1"
  },
  "allowScripts": {
    "node-pty@1.1.0": true,
    "@serialport/bindings-cpp@13.0.0": true,
    "cpu-features@0.0.10": true
  }
}
